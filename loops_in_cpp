#include <iostream>
using namespace std;

int main() {
    cout << "For Loop Example:\n";
    for (int i = 1; i <= 5; i++) {
        cout << i << " ";
    }

    cout << "\n\nWhile Loop Example:\n";
    int j = 1;
    while (j <= 5) {
        cout << j << " ";
        j++;
    }

    cout << "\n\nDo-While Loop Example:\n";
    int k = 1;
    do {
        cout << k << " ";
        k++;
    } while (k <= 5);

    cout << endl;
    return 0;
}
